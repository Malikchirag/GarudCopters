# Copy to .env and fill in for the parts of the pipeline that need them.
# Nothing here is required for /detect/image or /detect/video -- only for
# the pieces noted below.

# Required by scripts/download_dataset.py to pull the real dataset (see DATASET.md).
# Get one free at https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# Required by app/agent.py's generate_report node for the LLM-written plain-
# language summary. Without it, severity/recommendation still work (they're
# rule-based) and the summary falls back to a templated string.
ANTHROPIC_API_KEY=

# Optional overrides, see app/detector.py
GARUD_CV_WEIGHTS=models/best.pt
GARUD_CV_CONF=0.35
